<?xml version="1.0" encoding="utf-8"?>
<!--
  Лента обновлений Sparkle. Приложение читает её по адресу
  https://raw.githubusercontent.com/pnazarovich/transcriber/main/appcast.xml
  то есть отдаёт ленту сам GitHub, а отдельного хостинга у проекта нет.

  Файл пишет scripts/release.sh — руками сюда лазить не нужно. Свежий <item> он
  вставляет ПЕРЕД якорем ниже, поэтому новые версии оказываются в начале списка.
  Сами архивы лежат в GitHub Releases; здесь только ссылки, длины и подписи.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Transcriber</title>
    <link>https://raw.githubusercontent.com/pnazarovich/transcriber/main/appcast.xml</link>
    <description>Обновления Transcriber</description>
    <language>ru</language>
    <!-- NEW-ITEM-ANCHOR: сюда release.sh вставляет свежий <item>. Строку не трогать. -->
  </channel>
</rss>
